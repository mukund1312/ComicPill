    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "ComicPill uses the camera to scan your comic shelf."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ComicPill needs access to your photos to import screenshots of your digital library.",
          "cameraPermission": "ComicPill uses the camera so you can take a profile photo."
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "ComicPill looks only at the album you choose, to find comic screenshots for your reading plan.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/comicpillicon.png",
          "imageWidth": 160,
          "backgroundColor": "#0A0A0D",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Archive readers used through reflection / ServiceLoader, and our own native module\n-keep class expo.modules.comicarchive.** { *; }\n-keep class com.github.junrar.** { *; }\n-keep class org.apache.commons.compress.archivers.** { *; }\n-keep class org.apache.commons.compress.compressors.** { *; }\n# Optional dependencies of commons-compress / junrar that are not shipped\n-dontwarn org.slf4j.**\n-dontwarn org.apache.commons.compress.**\n-dontwarn com.github.luben.zstd.**\n-dontwarn org.brotli.dec.**\n-dontwarn org.objectweb.asm.**\n-dontwarn org.tukaani.xz.**\n-dontwarn javax.annotation.**\n"
          }
        }
      ],
      "./plugins/withBaselineProfile",
      "expo-sharing",
      "./plugins/withReleaseSigning"
    ]
  }
